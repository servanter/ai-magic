<svg width="1024" height="1024" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="bg-gradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#4F46E5;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#7C3AED;stop-opacity:1" />
    </linearGradient>
    <filter id="shadow">
      <feDropShadow dx="0" dy="4" stdDeviation="8" flood-opacity="0.3"/>
    </filter>
  </defs>
  
  <!-- Background -->
  <rect width="1024" height="1024" fill="url(#bg-gradient)"/>
  
  <!-- Decorative grid pattern -->
  <g opacity="0.1">
    <line x1="0" y1="256" x2="1024" y2="256" stroke="white" stroke-width="1"/>
    <line x1="0" y1="512" x2="1024" y2="512" stroke="white" stroke-width="1"/>
    <line x1="0" y1="768" x2="1024" y2="768" stroke="white" stroke-width="1"/>
    <line x1="256" y1="0" x2="256" y2="1024" stroke="white" stroke-width="1"/>
    <line x1="512" y1="0" x2="512" y2="1024" stroke="white" stroke-width="1"/>
    <line x1="768" y1="0" x2="768" y2="1024" stroke="white" stroke-width="1"/>
  </g>
  
  <!-- Title Area -->
  <rect x="80" y="100" width="864" height="280" rx="20" fill="white" opacity="0.15" filter="url(#shadow)"/>
  
  <!-- Main Title -->
  <text x="512" y="200" font-family="Arial, sans-serif" font-size="56" font-weight="bold" fill="white" text-anchor="middle">
    Best AI Background
  </text>
  <text x="512" y="270" font-family="Arial, sans-serif" font-size="56" font-weight="bold" fill="white" text-anchor="middle">
    Remover Tools 2026
  </text>
  
  <!-- Subtitle -->
  <text x="512" y="340" font-family="Arial, sans-serif" font-size="28" fill="white" text-anchor="middle" opacity="0.9">
    11 Tools Compared • Professional Testing Results
  </text>
  
  <!-- Tool comparison cards -->
  <g transform="translate(120, 450)">
    <!-- Card 1 -->
    <rect x="0" y="0" width="240" height="140" rx="12" fill="white" opacity="0.2" filter="url(#shadow)"/>
    <text x="120" y="50" font-family="Arial, sans-serif" font-size="32" font-weight="bold" fill="white" text-anchor="middle">95</text>
    <text x="120" y="75" font-family="Arial, sans-serif" font-size="14" fill="white" text-anchor="middle" opacity="0.8">/100</text>
    <text x="120" y="110" font-family="Arial, sans-serif" font-size="18" fill="white" text-anchor="middle">AImage AI</text>
    
    <!-- Card 2 -->
    <rect x="260" y="0" width="240" height="140" rx="12" fill="white" opacity="0.2" filter="url(#shadow)"/>
    <text x="380" y="50" font-family="Arial, sans-serif" font-size="32" font-weight="bold" fill="white" text-anchor="middle">92</text>
    <text x="380" y="75" font-family="Arial, sans-serif" font-size="14" fill="white" text-anchor="middle" opacity="0.8">/100</text>
    <text x="380" y="110" font-family="Arial, sans-serif" font-size="18" fill="white" text-anchor="middle">Remove.bg</text>
    
    <!-- Card 3 -->
    <rect x="520" y="0" width="240" height="140" rx="12" fill="white" opacity="0.2" filter="url(#shadow)"/>
    <text x="640" y="50" font-family="Arial, sans-serif" font-size="32" font-weight="bold" fill="white" text-anchor="middle">93</text>
    <text x="640" y="75" font-family="Arial, sans-serif" font-size="14" fill="white" text-anchor="middle" opacity="0.8">/100</text>
    <text x="640" y="110" font-family="Arial, sans-serif" font-size="18" fill="white" text-anchor="middle">Adobe Firefly</text>
  </g>
  
  <!-- Feature highlights -->
  <g transform="translate(80, 650)">
    <g>
      <circle cx="20" cy="20" r="8" fill="#10B981"/>
      <text x="40" y="26" font-family="Arial, sans-serif" font-size="18" fill="white">Edge Accuracy Test</text>
    </g>
    <g transform="translate(0, 50)">
      <circle cx="20" cy="20" r="8" fill="#10B981"/>
      <text x="40" y="26" font-family="Arial, sans-serif" font-size="18" fill="white">Processing Speed Analysis</text>
    </g>
    <g transform="translate(0, 100)">
      <circle cx="20" cy="20" r="8" fill="#10B981"/>
      <text x="40" y="26" font-family="Arial, sans-serif" font-size="18" fill="white">Pricing Value Comparison</text>
    </g>
    <g transform="translate(0, 150)">
      <circle cx="20" cy="20" r="8" fill="#10B981"/>
      <text x="40" y="26" font-family="Arial, sans-serif" font-size="18" fill="white">Real-World Case Studies</text>
    </g>
  </g>
  
  <!-- Bottom badge -->
  <g transform="translate(312, 900)">
    <rect x="0" y="0" width="400" height="60" rx="30" fill="white" opacity="0.2"/>
    <text x="200" y="38" font-family="Arial, sans-serif" font-size="22" font-weight="bold" fill="white" text-anchor="middle">
      500+ Images Tested • 80+ Hours Research
    </text>
  </g>
</svg>
